# ─── Database ───────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://your_user:your_pass@cluster.mongodb.net/ani-chan

# ─── Bot Identity ───────────────────────────────────────────────────────────
BOT_NAME=Ani-Chan Bot
BOT_PREFIX=.
# Optional — image used by menu-bearing commands (leave empty for none)
MENU_IMAGE_URL=

# ─── Ownership / Moderation ─────────────────────────────────────────────────
OWNER_NUMBER=1234567890@c.us

# ─── Chromium (Termux default; change only on non-Termux hosts) ─────────────
PUPPETEER_EXECUTABLE_PATH=/data/data/com.termux/files/usr/bin/chromium-browser

# ─── Registration / Age Verification (all optional, defaults shown) ─────────
MIN_REGISTRATION_AGE=18
AGE_VERIFICATION_LOCKOUT_DAYS=30

# ─── Anime News (.news + daily auto-broadcast, optional) ────────────────────
NEWS_RSS_QUERY=anime OR manga OR manhwa OR donghua

# ─── Google Gemini (AI chat / translation / transcription / image gen) ──────
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=
GEMINI_RENAME_MODEL=
GEMINI_RENAME_BATCH_SIZE=15
GEMINI_RENAME_DELAY_MS=8000
GEMINI_RENAME_MAX_DELAY_MS=90000
# Names that count as directly calling the AI persona by name in plain text
# (no command prefix needed) — comma-separated, multi-word entries allowed.
# Separate from BOT_NAME above: this is the persona's own name, not the
# app/account's.
AI_CALL_NAMES=Marin,Kitagawa,Marin Kitagawa

# ─── Persona-aware AI sticker analysis ──────────────────────────────────────
AI_STICKERS_ENABLED=false
AI_STICKER_AUTO_ANALYZE=true
AI_STICKER_ANALYSIS_VERSION=1
AI_STICKER_ANALYSIS_DELAY_MS=8000
# Minimum deterministic persona-match score before an automatic sticker may send.
AI_STICKER_MATCH_THRESHOLD=10
AI_STICKER_MAX_BYTES=2097152
AI_STICKER_DOWNLOAD_TIMEOUT_MS=30000

# ─── Fish Audio (voice replies) ─────────────────────────────────────────────
FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=

# ─── Cloudinary (profile pictures / card image repair) ──────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=

# ─── Downloaders / Anime sourcing ───────────────────────────────────────────
RAPIDAPI_KEY=
SAUCENAO_KEY=

DANBOORU_LOGIN=
DANBOORU_API_KEY=
GELBOORU_USER_ID=
GELBOORU_API_KEY=

# ─── Wikipedia / web image search (card repair + .wiki) ─────────────────────
WIKI_SEARCH_LANG=en
WIKI_SEARCH_NUM=5

# ─── Card image repair (all optional, defaults shown) ───────────────────────
REPAIR_MAX_CANDIDATES=5
REPAIR_VISION_TOP_N=2
REPAIR_MIN_SCORE=65
REPAIR_DELAY_MS=2000

# ─── Gemini quota protection (all optional, defaults shown) ─────────────────
# While sticker analysis runs in the background, Gemini commands reply
# "unavailable"; set to false to let them compete for the quota instead.
GEMINI_PAUSE_DURING_STICKER_ANALYSIS=true
# Commands that count as Gemini-backed (after alias resolution).
# GEMINI_COMMANDS=copilot,gpt,voice,imagine,translate,transcribe
# GEMINI_BUSY_MESSAGE=
# How long the analysis queue waits after a quota error (ms), doubling per
# consecutive failure up to the max. A Gemini "retry in Ns" hint overrides it.
AI_STICKER_QUOTA_COOLDOWN_MS=1800000
AI_STICKER_QUOTA_MAX_COOLDOWN_MS=7200000

# ─── Voice delivery (Fish Audio) - all optional, defaults shown ─────────────
# Higher temperature / top_p = more varied, more expressive speech (Fish default 0.7).
# A persona's meta.json "voice" block (speed, volume, temperature, topP) overrides these.
FISH_TEMPERATURE=0.8
FISH_TOP_P=0.8
FISH_SPEED=1
FISH_VOLUME_DB=0
# FISH_LATENCY=normal          # low | normal | balanced (only sent if set)
# FISH_CHUNK_LENGTH=200        # 100-300 (only sent if set)
# Adds ONE short [cue] such as [excited] to voice notes. Off by default: test with
# node scripts/fish-voice-test.js first, because a cue can be spoken aloud.
FISH_EXPRESSION_TAGS=false
AI_VOICE_MAX_OUTPUT_TOKENS=500

# ─── AI reacts to reactions on its own messages (no message is ever sent) ───
AI_REACT_TO_REACTIONS=true
AI_REACT_CHANCE=0.6
AI_REACT_COOLDOWN_MS=15000
AI_REACT_DELAY_MIN_MS=1500
AI_REACT_DELAY_MAX_MS=6000
AI_MESSAGE_MEMORY_MS=86400000
AI_MESSAGE_MEMORY_MAX=1000

# ─── Stickers chosen by the AI itself ───────────────────────────────────────
# Each text reply shows the AI a numbered list of usable stickers and it picks one
# (or none). Max stickers offered per reply, and how many of the most recently
# sent stickers in a chat are left out so it does not repeat itself (0 = off).
AI_STICKER_CATALOGUE_MAX=48
AI_STICKER_RECENT_EXCLUDE=6
