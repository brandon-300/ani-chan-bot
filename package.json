{
  "name": "ani-chan-bot",
  "version": "1.0.0",
  "description": "Ani-Chan Bot - WhatsApp Bot with AI Personas (TypeScript migration in progress)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "tsx index.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pm2": "pm2 start ecosystem.config.cjs",
    "stickers:reset": "node scripts/reset-ai-sticker-library.js",
    "stickers:import": "node scripts/import-anime-sticker-packs.js",
    "test": "vitest run tests/baileys-integration.js tests/baileys-migration-regressions.test.js tests/api-serializers.test.ts",
    "test:watch": "vitest watch tests/baileys-integration.js",
    "pm2:stop": "pm2 delete ani-chan-bot-baileys",
    "logs": "pm2 logs ani-chan-bot-baileys --lines 30"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "axios": "^1.6.0",
    "chess.js": "^1.0.0",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.0.0",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.0",
    "link-preview-js": "^3.0.0",
    "mongoose": "^8.0.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "node-webpmux": "^3.2.1",
    "openai": "^4.0.0",
    "pino": "^8.17.2",
    "puppeteer-core": "^25.12.0",
    "wa-sticker-formatter": "^4.4.4",
    "yt-search": "^2.13.1",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
