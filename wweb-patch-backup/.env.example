# ==========================================
# Ani-Chan Bot Configuration (Baileys Version)
# ==========================================

# Bot Identity
BOT_NAME="Ani-Chan Bot"
BOT_PREFIX="."
MENU_IMAGE_URL=""

# MongoDB Connection
MONGO_URI="mongodb://localhost:27017/ani-chan-bot"

# WhatsApp Authentication
# For Baileys, pairing code is recommended for Termux
# The bot will generate and display a pairing code on first run
BOT_NUMBER=""  # Optional: Your bot's phone number in international format (e.g., 2348012345678)

# Bot Owner (for unlimited chat history and admin commands)
OWNER=""  # Your WhatsApp ID (e.g., 2348012345678@s.whatsapp.net)

# Moderators (comma-separated list of WhatsApp IDs)
MODS=""

# ==========================================
# AI Configuration
# ==========================================

# Active AI Persona (marin, karane, rias)
AI_PERSONA="marin"

# AI Call Names Override (comma-separated)
# Leave empty to use persona's own callNames from meta.json
AI_CALL_NAMES=""

# Enable AI Stickers
AI_STICKERS_ENABLED="true"

# ==========================================
# API Keys
# ==========================================

# Gemini API Key (for AI commands)
GEMINI_API_KEY=""

# Fish Audio API Key (for TTS/voice commands)
FISH_API_KEY=""

# Fish Audio Voice ID (optional override)
FISH_VOICE_ID=""

# Fish Audio Model
FISH_MODEL="s2.1-pro-free"

# RapidAPI Key (for upscale, etc.)
RAPIDAPI_KEY=""

# Cloudinary (for image hosting)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ==========================================
# News Configuration
# ==========================================

NEWS_RSS_QUERY="anime OR manga OR manhwa OR donghua"
NEWS_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
NEWS_FETCH_TIMEOUT_MS=20000
NEWS_SEND_DELAY_MS=2000
NEWS_MAX_ARTICLE_AGE_DAYS=7

# ==========================================
# Registration Configuration
# ==========================================

MIN_REGISTRATION_AGE=18
AGE_VERIFICATION_LOCKOUT_DAYS=30

# ==========================================
# Logging Configuration
# ==========================================

LOG_LEVEL="info"

# ==========================================
# Rate Limiting
# ==========================================

RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ==========================================
# Game Configuration
# ==========================================

CHESS_TIMEOUT_MINUTES=30
CONNECT4_TIMEOUT_MINUTES=30
TIC_TAC_TOE_TIMEOUT_MINUTES=30
BATTLE_TIMEOUT_MINUTES=30
QUIZ_QUESTION_TIMEOUT_MINUTES=5

# ==========================================
# Economy Configuration
# ==========================================

DAILY_REWARD_AMOUNT=100
DAILY_INTEREST_RATE=0.05
LOAN_INTEREST_RATE=0.10
LOAN_DURATION_DAYS=7
WITHDRAW_FEE=10

# ==========================================
# Card Configuration
# ==========================================

CARD_DROP_INTERVAL_MINUTES=60
CARD_DROP_AMOUNT=1
MAX_CARDS_PER_USER=50
CARD_TRADE_TAX=5

# ==========================================
# AI Sticker Library Configuration
# ==========================================

AI_STICKER_AUTO_ANALYZE="true"
AI_STICKER_IMPORT_TIMEOUT_MINUTES=10
AI_STICKER_MAX_BYTES=2097152
AI_STICKER_DOWNLOAD_TIMEOUT_MS=30000
AI_STICKER_ANALYSIS_VERSION=1
AI_STICKER_MATCH_THRESHOLD=18
AI_STICKER_MIN_PERSONA_FIT=0.6
AI_STICKER_ANALYSIS_DELAY_MS=8000

# ==========================================
# Gemini Quota Protection
# ==========================================

AI_STICKER_QUOTA_COOLDOWN_MS=1800000
AI_STICKER_QUOTA_MAX_COOLDOWN_MS=7200000
GEMINI_PAUSE_DURING_STICKER_ANALYSIS="true"
GEMINI_COMMANDS="copilot,gpt,voice,imagine,translate,transcribe"
GEMINI_BUSY_MESSAGE="⏳ This command is currently unavailable. Please try again later."

# ==========================================
# Fish Audio Configuration
# ==========================================

FISH_REQUEST_TIMEOUT_MS=45000
